{
  "name": "scholaflow",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.6.0",
  "imports": {
    "#/*": "./src/*"
  },
  "scripts": {
    "dev": "vite dev --port 3000",
    "generate-routes": "tsr generate",
    "build": "node scripts/generate-assetlinks.mjs && vite build",
    "preview": "vite preview",
    "format": "biome format",
    "lint": "biome lint",
    "check": "biome check && node scripts/sort-imports.mjs --check",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:push": "drizzle-kit push",
    "db:pull": "drizzle-kit pull",
    "db:studio": "drizzle-kit studio",
    "typecheck": "tsc --noEmit",
    "check:fix": "biome check --write && node scripts/sort-imports.mjs",
    "test": "vitest run",
    "imports:fix": "node scripts/sort-imports.mjs",
    "imports:check": "node scripts/sort-imports.mjs --check"
  },
  "dependencies": {
    "@fontsource-variable/quicksand": "^5.3.0",
