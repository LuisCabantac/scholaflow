    "nodemailer": "^10.5.0",
    "pg": "^8.23.1",
    "radix-ui": "^1.8.1",
    "react": "^19.3.1",
    "react-colorful": "^5.8.1",
    "react-day-picker": "^10.0.2",
    "react-dom": "^19.3.1",
    "react-i18next": "^17.1.13",
    "react-textarea-autosize": "^8.5.9",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.7.0",
    "tailwindcss": "^4.3.5",
